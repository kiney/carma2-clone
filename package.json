  "dependencies": {
    "three": "0.180.0",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "playwright-core": "1.56.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
